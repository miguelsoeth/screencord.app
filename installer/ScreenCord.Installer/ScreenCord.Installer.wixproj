<Project Sdk="WixToolset.Sdk/6.0.2">

  <!--
    Instalador MSI do ScreenCord: dotnet build installer/ScreenCord.Installer -c Release
    Publica o app (exe único, autocontido) e empacota em bin/x64/Release/pt-BR/ScreenCord-Setup.msi.
    A versão do instalador é a <Version> do src/ScreenCord/ScreenCord.csproj.
  -->
  <PropertyGroup>
    <OutputName>ScreenCord-Setup</OutputName>
    <InstallerPlatform>x64</InstallerPlatform>
    <Cultures>pt-BR</Cultures>
    <AppProject>$(MSBuildProjectDirectory)\..\..\src\ScreenCord\ScreenCord.csproj</AppProject>
    <AppPublishDir>$(MSBuildProjectDirectory)\obj\app\</AppPublishDir>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="WixToolset.UI.wixext" Version="6.0.2" />
    <PackageReference Include="WixToolset.Util.wixext" Version="6.0.2" />
  </ItemGroup>

  <Target Name="PublishApp" BeforeTargets="BeforeBuild">
    <XmlPeek XmlInputPath="$(AppProject)" Query="/Project/PropertyGroup/Version/text()">
      <Output TaskParameter="Result" PropertyName="AppVersion" />
    </XmlPeek>
    <RemoveDir Directories="$(AppPublishDir)" />
    <Exec Command="dotnet publish &quot;$(AppProject)&quot; -c Release -r win-x64 --self-contained true -p:PublishSingleFile=true -p:IncludeNativeLibrariesForSelfExtract=true -p:DebugType=none -o &quot;$(AppPublishDir)&quot;" />
    <PropertyGroup>
      <DefineConstants>$(DefineConstants);AppVersion=$(AppVersion);AppPublishDir=$(AppPublishDir)</DefineConstants>
    </PropertyGroup>
  </Target>

</Project>
