<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">

  <!--
    Instalação por usuário em %LocalAppData%\Programs\ScreenCord: não pede administrador.
    O UpgradeCode nunca muda; é ele que faz uma versão nova substituir a anterior.
    Em perfil de usuário o Windows Installer exige chave de registro (HKCU) como KeyPath de cada componente.
  -->
  <Package Name="ScreenCord"
           Manufacturer="Miguel Soeth"
           Version="$(var.AppVersion)"
           UpgradeCode="7ACBC1F4-008B-40B1-8D9D-5C7D5EF1A822"
           Scope="perUser"
           Language="1046"
           Codepage="1252">

    <MajorUpgrade AllowSameVersionUpgrades="yes"
                  DowngradeErrorMessage="Uma versão mais nova do ScreenCord já está instalada." />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <Icon Id="ScreenCordIcon" SourceFile="..\..\src\ScreenCord\Assets\screencord.ico" />
    <Property Id="ARPPRODUCTICON" Value="ScreenCordIcon" />

    <!--
      Idioma do app (pt, en ou es), escolhido na tela "Idioma" e gravado em HKCU\Software\ScreenCord\Language, que o
      app lê ao abrir e grava quando a pessoa troca o idioma lá dentro. Numa atualização (inclusive a automática, que
      roda sem telas), o valor salvo é lido de volta e mantido. Sem valor salvo, vem do idioma do Windows.
    -->
    <Property Id="SCLANGUAGE" Value="en" Secure="yes" />
    <Property Id="SCSAVEDLANGUAGE">
      <RegistrySearch Id="SavedLanguage" Root="HKCU" Key="Software\ScreenCord" Name="Language" Type="raw" />
    </Property>
    <SetProperty Id="SCLANGUAGE" Action="DefaultLanguagePt" Value="pt" After="AppSearch" Sequence="both"
                 Condition="UserLanguageID = 1046 OR UserLanguageID = 2070" />
    <SetProperty Id="SCLANGUAGE" Action="DefaultLanguageEs1" Value="es" After="DefaultLanguagePt" Sequence="both"
                 Condition="UserLanguageID = 1034 OR UserLanguageID = 3082 OR UserLanguageID = 2058 OR UserLanguageID = 11274 OR UserLanguageID = 13322 OR UserLanguageID = 9226 OR UserLanguageID = 5130 OR UserLanguageID = 7178" />
    <SetProperty Id="SCLANGUAGE" Action="DefaultLanguageEs2" Value="es" After="DefaultLanguageEs1" Sequence="both"
                 Condition="UserLanguageID = 12298 OR UserLanguageID = 17418 OR UserLanguageID = 4106 OR UserLanguageID = 18442 OR UserLanguageID = 6154 OR UserLanguageID = 15370 OR UserLanguageID = 10250 OR UserLanguageID = 20490" />
    <SetProperty Id="SCLANGUAGE" Action="DefaultLanguageEs3" Value="es" After="DefaultLanguageEs2" Sequence="both"
                 Condition="UserLanguageID = 21514 OR UserLanguageID = 14346 OR UserLanguageID = 8202 OR UserLanguageID = 16394 OR UserLanguageID = 19466 OR UserLanguageID = 22538" />
    <SetProperty Id="SCLANGUAGE" Action="SavedLanguage" Value="[SCSAVEDLANGUAGE]" After="DefaultLanguageEs3" Sequence="both"
                 Condition="SCSAVEDLANGUAGE = &quot;pt&quot; OR SCSAVEDLANGUAGE = &quot;en&quot; OR SCSAVEDLANGUAGE = &quot;es&quot;" />

    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="UserProgramsFolder" Name="Programs">
        <Directory Id="INSTALLFOLDER" Name="ScreenCord" />
      </Directory>
    </StandardDirectory>

    <ComponentGroup Id="AppFiles" Directory="INSTALLFOLDER">
      <Component Id="MainExecutable" Guid="34D767EE-787D-4F1B-BCA8-636E6FA742ED">
        <File Id="ScreenCordExe" Source="$(var.AppPublishDir)ScreenCord.exe" />
        <RegistryValue Root="HKCU" Key="Software\ScreenCord\Installer" Name="App" Type="integer" Value="1" KeyPath="yes" />
        <RemoveFolder Id="RemoveInstallFolder" On="uninstall" />
        <RemoveFolder Id="RemoveUserProgramsFolder" Directory="UserProgramsFolder" On="uninstall" />
      </Component>
      <Component Id="LanguagePreference" Guid="2EE13A66-AF6D-4ACF-B7CA-9B94D364309F">
        <RegistryValue Root="HKCU" Key="Software\ScreenCord" Name="Language" Type="string" Value="[SCLANGUAGE]" KeyPath="yes" />
      </Component>
      <Component Id="AppSettings" Guid="F02E0D4F-AED4-4C11-9A7B-40853EF150D2">
        <File Id="AppSettingsJson" Source="$(var.AppPublishDir)appsettings.json" />
        <RegistryValue Root="HKCU" Key="Software\ScreenCord\Installer" Name="Settings" Type="integer" Value="1" KeyPath="yes" />
      </Component>
      <!-- A GPL-3.0 do app e as licenças dos componentes de terceiros, que exigem ir junto com o binário. -->
      <Component Id="LicenseFiles" Guid="9B3F2C61-5E8A-4D7B-A0C4-1F6E2D8B7A35">
        <File Id="LicenseTxt" Source="..\..\LICENSE" Name="LICENSE.txt" />
        <File Id="ThirdPartyNoticesTxt" Source="..\..\THIRD-PARTY-NOTICES.txt" />
        <RegistryValue Root="HKCU" Key="Software\ScreenCord\Installer" Name="LicenseFiles" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </ComponentGroup>

    <StandardDirectory Id="ProgramMenuFolder">
      <Component Id="StartMenuShortcut">
        <Shortcut Id="StartMenuShortcut" Name="ScreenCord" Description="Compartilhamento de tela com amigos do Discord"
                  Target="[INSTALLFOLDER]ScreenCord.exe" WorkingDirectory="INSTALLFOLDER" Icon="ScreenCordIcon" />
        <RegistryValue Root="HKCU" Key="Software\ScreenCord\Installer" Name="StartMenuShortcut" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </StandardDirectory>

    <StandardDirectory Id="DesktopFolder">
      <Component Id="DesktopShortcut">
        <Shortcut Id="DesktopShortcut" Name="ScreenCord" Description="Compartilhamento de tela com amigos do Discord"
                  Target="[INSTALLFOLDER]ScreenCord.exe" WorkingDirectory="INSTALLFOLDER" Icon="ScreenCordIcon" />
        <RegistryValue Root="HKCU" Key="Software\ScreenCord\Installer" Name="DesktopShortcut" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </StandardDirectory>

    <Feature Id="Main">
      <ComponentGroupRef Id="AppFiles" />
      <ComponentRef Id="StartMenuShortcut" />
      <ComponentRef Id="DesktopShortcut" />
    </Feature>

    <!-- Telas: termos e progresso; no fim, caixa "Abrir o ScreenCord" já marcada. -->
    <WixVariable Id="WixUILicenseRtf" Value="License.rtf" />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOXTEXT" Value="Abrir o ScreenCord" />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOX" Value="1" />
    <Property Id="WixShellExecTarget" Value="[#ScreenCordExe]" />
    <CustomAction Id="LaunchApplication" DllEntry="WixShellExec" Impersonate="yes" BinaryRef="Wix4UtilCA_$(sys.BUILDARCHSHORT)" />

    <!--
      Salas locais: na primeira instalação (não nas atualizações, que rodam sem janela), o próprio exe cria a regra
      do Firewall do Windows pedindo a permissão do Windows (UAC). Se a pessoa recusar, a instalação segue e o app
      oferece "Liberar no firewall" quando ela criar uma sala ou compartilhar numa.
    -->
    <CustomAction Id="ConfigureFirewall" Directory="INSTALLFOLDER" Execute="immediate" Impersonate="yes" Return="ignore"
                  ExeCommand="powershell.exe -NoProfile -NonInteractive -WindowStyle Hidden -Command &quot;Start-Process -FilePath '[INSTALLFOLDER]ScreenCord.exe' -ArgumentList '--configure-firewall' -Verb RunAs -WindowStyle Hidden -Wait&quot;" />
    <!--
      Ao desinstalar (não nas atualizações, em que a versão nova continua usando a regra), o exe ainda instalado apaga
      a regra. Ele mesmo confere se ela existe e só então pede a permissão do Windows; recusar não impede a desinstalação.
      Imediata, roda antes de o script remover os arquivos.
    -->
    <CustomAction Id="RemoveFirewall" FileRef="ScreenCordExe" ExeCommand="--remove-firewall" Execute="immediate" Impersonate="yes" Return="ignore" />
    <InstallExecuteSequence>
      <Custom Action="ConfigureFirewall" After="InstallFinalize" Condition="NOT Installed AND NOT WIX_UPGRADE_DETECTED AND UILevel &gt;= 4" />
      <Custom Action="RemoveFirewall" Before="RemoveFiles" Condition="REMOVE ~= &quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE" />
    </InstallExecuteSequence>

    <!-- Antes dos termos, só na instalação com telas (a atualização automática é /passive e não mostra nenhuma). -->
    <InstallUISequence>
      <Show Dialog="LanguageDlg" Before="WelcomeEulaDlg" Condition="NOT Installed" />
    </InstallUISequence>

    <UI>
      <ui:WixUI Id="WixUI_Minimal" />
      <!-- No mesmo formato das telas do WixUI (370x270, faixa no topo, botões embaixo). Os nomes ficam no próprio idioma. -->
      <Dialog Id="LanguageDlg" Width="370" Height="270" Title="!(loc.WelcomeEulaDlg_Title)">
        <Control Id="BannerBitmap" Type="Bitmap" X="0" Y="0" Width="370" Height="44" TabSkip="no" Text="WixUI_Bmp_Banner" />
        <Control Id="BannerLine" Type="Line" X="0" Y="44" Width="370" Height="0" />
        <Control Id="Title" Type="Text" X="15" Y="6" Width="290" Height="15" Transparent="yes" NoPrefix="yes"
                 Text="{\WixUI_Font_Title}Idioma · Language · Idioma" />
        <Control Id="Description" Type="Text" X="25" Y="22" Width="290" Height="20" Transparent="yes" NoPrefix="yes"
                 Text="Escolha o idioma do ScreenCord. Dá para trocar depois, no próprio app." />
        <Control Id="Choice" Type="RadioButtonGroup" X="30" Y="64" Width="300" Height="66" Property="SCLANGUAGE">
          <RadioButtonGroup Property="SCLANGUAGE">
            <RadioButton Value="pt" X="0" Y="0" Width="300" Height="18" Text="Português" />
            <RadioButton Value="en" X="0" Y="24" Width="300" Height="18" Text="English" />
            <RadioButton Value="es" X="0" Y="48" Width="300" Height="18" Text="Español" />
          </RadioButtonGroup>
        </Control>
        <Control Id="Hint" Type="Text" X="30" Y="146" Width="310" Height="40" Transparent="yes" NoPrefix="yes"
                 Text="Choose the ScreenCord language. You can change it later in the app.&#13;&#10;Elige el idioma de ScreenCord. Puedes cambiarlo después en la aplicación." />
        <Control Id="BottomLine" Type="Line" X="0" Y="234" Width="370" Height="0" />
        <Control Id="Next" Type="PushButton" X="236" Y="243" Width="56" Height="17" Default="yes" Text="!(loc.WixUINext)">
          <Publish Event="EndDialog" Value="Return" />
        </Control>
        <Control Id="Cancel" Type="PushButton" X="304" Y="243" Width="56" Height="17" Cancel="yes" Text="!(loc.WixUICancel)">
          <Publish Event="SpawnDialog" Value="CancelDlg" />
        </Control>
      </Dialog>
      <Publish Dialog="ExitDialog" Control="Finish" Event="DoAction" Value="LaunchApplication"
               Condition="WIXUI_EXITDIALOGOPTIONALCHECKBOX = 1 and NOT Installed" />
    </UI>

  </Package>
</Wix>
