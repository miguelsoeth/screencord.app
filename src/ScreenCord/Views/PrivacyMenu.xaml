<UserControl x:Class="ScreenCord.Views.PrivacyMenu"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:ScreenCord.Localization"
             xmlns:views="clr-namespace:ScreenCord.Views">
    <!-- Como o botão de idioma: menu embaixo, alinhado à direita do botão. Liga e desliga o relatório de erros. -->
    <UserControl.Resources>
        <views:InverseBooleanConverter x:Key="InverseBool" />
    </UserControl.Resources>

    <Grid>
        <!-- Com o menu aberto, o clique no botão só fecha o menu (sem reabrir em seguida). -->
        <ToggleButton x:Name="Toggle" Style="{StaticResource HeaderIconToggleButton}"
                      IsHitTestVisible="{Binding IsOpen, ElementName=Menu, Converter={StaticResource InverseBool}}"
                      ToolTip="{l:Tr Privacy}" AutomationProperties.Name="{l:Tr Privacy}">
            <Path Data="{StaticResource ShieldIcon}" Style="{StaticResource IconPath}" />
        </ToggleButton>

        <Popup x:Name="Menu" IsOpen="{Binding IsChecked, ElementName=Toggle, Mode=TwoWay}" StaysOpen="False"
               PlacementTarget="{Binding ElementName=Toggle}" Placement="Custom"
               AllowsTransparency="True" PopupAnimation="Fade" Opened="OnMenuOpened">
            <Border Style="{StaticResource Card}" Padding="6" Margin="14" Width="280"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                    TextElement.Foreground="{StaticResource TextBrush}">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="22" ShadowDepth="0" Opacity="0.55" Color="Black" />
                </Border.Effect>
                <StackPanel>
                    <TextBlock Text="{l:Tr Privacy}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource MutedTextBrush}" Margin="10,4,10,4" />
                    <Button x:Name="ErrorReportsOption" Style="{StaticResource MenuOption}" Click="OnErrorReportsClick"
                            AutomationProperties.Name="{l:Tr SendErrorReports}">
                        <DockPanel>
                            <Path x:Name="ErrorReportsCheck" DockPanel.Dock="Right" Data="{StaticResource CheckIcon}" Style="{StaticResource IconPath}"
                                  Fill="{StaticResource AccentBrush}" Width="14" Height="14" Margin="12,0,0,0" />
                            <TextBlock Text="{l:Tr SendErrorReports}" />
                        </DockPanel>
                    </Button>
                    <TextBlock Text="{l:Tr ErrorReportsHint}" FontSize="12" Foreground="{StaticResource MutedTextBrush}"
                               TextWrapping="Wrap" Margin="10,2,10,8" />
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</UserControl>
