<UserControl x:Class="ScreenCord.Views.SettingsMenu"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:ScreenCord.Localization"
             xmlns:views="clr-namespace:ScreenCord.Views">
    <!-- Engrenagem no estilo das ações do cabeçalho: idioma, privacidade e "Sobre" num só menu, que abre embaixo,
         alinhado à direita do botão. Usado no cabeçalho e no login (o DataContext é o MainViewModel). -->
    <UserControl.Resources>
        <views:InverseBooleanConverter x:Key="InverseBool" />
        <Style x:Key="MenuSection" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
            <Setter Property="Margin" Value="10,4,10,4" />
        </Style>
        <Style x:Key="MenuCheck" TargetType="Path" BasedOn="{StaticResource IconPath}">
            <Setter Property="DockPanel.Dock" Value="Right" />
            <Setter Property="Data" Value="{StaticResource CheckIcon}" />
            <Setter Property="Fill" Value="{StaticResource AccentBrush}" />
            <Setter Property="Width" Value="14" />
            <Setter Property="Height" Value="14" />
            <Setter Property="Margin" Value="12,0,0,0" />
        </Style>
        <Style x:Key="MenuSeparator" TargetType="Rectangle">
            <Setter Property="Height" Value="1" />
            <Setter Property="Margin" Value="4,6" />
            <Setter Property="Fill" Value="{StaticResource BorderBrush}" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <!-- Com o menu aberto, o clique no botão só fecha o menu (sem reabrir em seguida). -->
        <ToggleButton x:Name="Toggle" Style="{StaticResource HeaderIconToggleButton}"
                      IsHitTestVisible="{Binding IsOpen, ElementName=Menu, Converter={StaticResource InverseBool}}"
                      ToolTip="{l:Tr Settings}" AutomationProperties.Name="{l:Tr Settings}">
            <Path Data="{StaticResource SettingsIcon}" Style="{StaticResource IconPath}" />
        </ToggleButton>

        <Popup x:Name="Menu" IsOpen="{Binding IsChecked, ElementName=Toggle, Mode=TwoWay}" StaysOpen="False"
               PlacementTarget="{Binding ElementName=Toggle}" Placement="Custom"
               AllowsTransparency="True" PopupAnimation="Fade" Opened="OnMenuOpened">
            <Border Style="{StaticResource Card}" Padding="6" Margin="14" Width="280"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                    TextElement.Foreground="{StaticResource TextBrush}">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="22" ShadowDepth="0" Opacity="0.55" Color="Black" />
                </Border.Effect>
                <StackPanel KeyboardNavigation.DirectionalNavigation="Cycle">
                    <!-- Idioma: troca na hora e salva a escolha (a mesma que o instalador grava). -->
                    <TextBlock Text="{l:Tr Language}" Style="{StaticResource MenuSection}" />
                    <Button x:Name="PortugueseOption" Style="{StaticResource MenuOption}" AutomationProperties.Name="{l:Tr LanguagePortuguese}" Tag="pt" Click="OnLanguageClick">
                        <DockPanel>
                            <Path x:Name="PortugueseCheck" Style="{StaticResource MenuCheck}" />
                            <TextBlock Text="{l:Tr LanguagePortuguese}" />
                        </DockPanel>
                    </Button>
                    <Button x:Name="EnglishOption" Style="{StaticResource MenuOption}" AutomationProperties.Name="{l:Tr LanguageEnglish}" Tag="en" Click="OnLanguageClick">
                        <DockPanel>
                            <Path x:Name="EnglishCheck" Style="{StaticResource MenuCheck}" />
                            <TextBlock Text="{l:Tr LanguageEnglish}" />
                        </DockPanel>
                    </Button>
                    <Button x:Name="SpanishOption" Style="{StaticResource MenuOption}" AutomationProperties.Name="{l:Tr LanguageSpanish}" Tag="es" Click="OnLanguageClick">
                        <DockPanel>
                            <Path x:Name="SpanishCheck" Style="{StaticResource MenuCheck}" />
                            <TextBlock Text="{l:Tr LanguageSpanish}" />
                        </DockPanel>
                    </Button>

                    <Rectangle Style="{StaticResource MenuSeparator}" />

                    <!-- Privacidade: liga e desliga o relatório de erros na hora. -->
                    <TextBlock Text="{l:Tr Privacy}" Style="{StaticResource MenuSection}" />
                    <Button Style="{StaticResource MenuOption}" Click="OnErrorReportsClick"
                            AutomationProperties.Name="{l:Tr SendErrorReports}">
                        <DockPanel>
                            <Path x:Name="ErrorReportsCheck" Style="{StaticResource MenuCheck}" />
                            <TextBlock Text="{l:Tr SendErrorReports}" />
                        </DockPanel>
                    </Button>
                    <TextBlock Text="{l:Tr ErrorReportsHint}" FontSize="12" Foreground="{StaticResource MutedTextBrush}"
                               TextWrapping="Wrap" Margin="10,2,10,4" />

                    <Rectangle Style="{StaticResource MenuSeparator}" />

                    <Button Style="{StaticResource MenuOption}" Click="OnAboutClick"
                            Command="{Binding About.OpenCommand}" AutomationProperties.Name="{l:Tr AboutScreenCord}">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource InfoIcon}" Style="{StaticResource IconPath}" Width="16" Height="16" />
                            <TextBlock Text="{l:Tr AboutScreenCord}" Margin="10,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</UserControl>
