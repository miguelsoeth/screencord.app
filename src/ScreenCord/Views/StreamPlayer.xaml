<UserControl x:Class="ScreenCord.Views.StreamPlayer"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:ScreenCord.Localization"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:ScreenCord.ViewModels"
             xmlns:views="clr-namespace:ScreenCord.Views"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:StreamViewerViewModel}"
             Background="Black"
             Foreground="{StaticResource TextBrush}"
             Focusable="True">

    <UserControl.Resources>
        <views:InverseBooleanConverter x:Key="InverseBool" />
        <views:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibility" />
    </UserControl.Resources>

    <UserControl.InputBindings>
        <KeyBinding Key="F11" Command="{x:Static views:ViewerCommands.ToggleFullScreen}" />
        <KeyBinding Key="Escape" Command="{x:Static views:ViewerCommands.ExitFullScreen}" />
        <KeyBinding Key="M" Command="{Binding ToggleMuteCommand}" />
    </UserControl.InputBindings>

    <Grid MouseMove="OnMouseMove" MouseLeave="OnMouseLeave" Background="Transparent">
        <!-- Vídeo: mantém a proporção, com faixas pretas se a área tiver outro formato. -->
        <Image x:Name="Video" Stretch="Uniform" RenderOptions.BitmapScalingMode="Linear"
               MouseLeftButtonDown="OnVideoMouseDown" />

        <!-- Conectando / aguardando / terminou -->
        <Border HorizontalAlignment="Center" VerticalAlignment="Center" Background="#D90A0B10"
                CornerRadius="10" Padding="24,18" Visibility="{Binding ShowOverlay, Converter={StaticResource BoolToVisibility}}">
            <StackPanel>
                <TextBlock Text="{Binding StatusText}" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center" TextAlignment="Center"
                           TextWrapping="Wrap" MaxWidth="360" />
                <ProgressBar IsIndeterminate="True" Width="180" Height="4" Margin="0,12,0,0"
                             Foreground="{StaticResource AccentBrush}" Background="{StaticResource SurfaceRaisedBrush}" BorderThickness="0"
                             Visibility="{Binding IsConnecting, Converter={StaticResource BoolToVisibility}}" />
            </StackPanel>
        </Border>

        <!-- Barra sobre a parte de baixo do vídeo: quem, qualidade, áudio, tela cheia e fechar.
             Some depois de alguns segundos sem mexer o mouse (e logo que ele sai do vídeo). -->
        <Border x:Name="ControlBar" VerticalAlignment="Bottom" Background="#E00A0B10" Padding="14,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="{StaticResource LiveBrush}" CornerRadius="4" Padding="6,1" VerticalAlignment="Center"
                            Visibility="{Binding IsEnded, Converter={StaticResource InverseBoolToVisibility}}">
                        <TextBlock Text="{l:Tr Live}" FontSize="10" FontWeight="Bold" Foreground="White" />
                    </Border>
                    <TextBlock Text="{Binding Sharer.DisplayName}" FontSize="13" FontWeight="SemiBold" Margin="10,0,0,0" VerticalAlignment="Center" />
                    <TextBlock x:Name="QualityLabel" Text="{Binding QualityText}" FontSize="12" Foreground="{StaticResource MutedTextBrush}" Margin="10,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <StackPanel Orientation="Horizontal" Visibility="{Binding HasAudio, Converter={StaticResource BoolToVisibility}}">
                        <Button Style="{StaticResource GhostIconButton}" Width="32" Height="32"
                                Command="{Binding ToggleMuteCommand}" ToolTip="{l:Tr MuteTooltip}" AutomationProperties.Name="{l:Tr Mute}">
                            <Path Width="18" Height="18">
                                <Path.Style>
                                    <Style TargetType="Path" BasedOn="{StaticResource IconPath}">
                                        <Setter Property="Data" Value="{StaticResource VolumeIcon}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsMuted}" Value="True">
                                                <Setter Property="Data" Value="{StaticResource MuteIcon}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Path.Style>
                            </Path>
                        </Button>
                        <!-- Clicar na trilha leva o volume ao ponto clicado (e já dá para arrastar); a roda do mouse ajusta de 5 em 5%. -->
                        <Slider x:Name="VolumeSlider" Width="100" Minimum="0" Maximum="1" SmallChange="0.05" LargeChange="0.1"
                                IsMoveToPointEnabled="True" Value="{Binding Volume}" VerticalAlignment="Center" Margin="6,0,12,0"
                                PreviewMouseWheel="OnVolumeMouseWheel"
                                AutomationProperties.Name="{l:Tr Volume}" IsEnabled="{Binding IsMuted, Converter={StaticResource InverseBool}}" />
                    </StackPanel>
                    <Button x:Name="FullScreenButton" Style="{StaticResource GhostIconButton}" Width="32" Height="32"
                            Command="{x:Static views:ViewerCommands.ToggleFullScreen}" ToolTip="{l:Tr FullScreenTooltip}" AutomationProperties.Name="{l:Tr FullScreen}">
                        <Path Data="{StaticResource FullscreenIcon}" Style="{StaticResource IconPath}" Width="18" Height="18" />
                    </Button>
                    <Button x:Name="CloseButton" Style="{StaticResource GhostIconButton}" Width="32" Height="32" Margin="4,0,0,0"
                            Click="OnCloseClick" ToolTip="{l:Tr StopWatching}" AutomationProperties.Name="{l:Tr StopWatching}">
                        <Path Data="{StaticResource CloseIcon}" Style="{StaticResource IconPath}" Width="16" Height="16" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
