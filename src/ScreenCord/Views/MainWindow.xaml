<Window x:Class="ScreenCord.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:ScreenCord.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
        Title="ScreenCord"
        Icon="/Assets/screencord.ico"
        Width="860" Height="640"
        MinWidth="520" MinHeight="460"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBrush}"
        Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">

    <Grid>

        <!-- Verificação da sessão salva -->
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                    Visibility="{Binding IsInitializing, Converter={StaticResource BoolToVisibility}}">
            <TextBlock Text="Carregando sessão…" Style="{StaticResource MutedText}" HorizontalAlignment="Center" />
            <ProgressBar IsIndeterminate="True" Width="200" Height="4" Margin="0,12,0,0"
                         Foreground="{StaticResource AccentBrush}" Background="{StaticResource SurfaceRaisedBrush}" BorderThickness="0" />
        </StackPanel>

        <!-- Tela inicial -->
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      Visibility="{Binding ShowLogin, Converter={StaticResource BoolToVisibility}}">
            <Border Style="{StaticResource Card}" Padding="36" Margin="24" MaxWidth="440"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel>
                    <Image Source="/Assets/screencord.png" Width="96" Height="96" HorizontalAlignment="Center" Margin="0,0,0,12"
                           RenderOptions.BitmapScalingMode="HighQuality" />
                    <TextBlock Style="{StaticResource Wordmark}" FontSize="30" HorizontalAlignment="Center">
                        <Run Text="Screen" /><Run Text="Cord" Foreground="{StaticResource WordmarkAccentBrush}" />
                    </TextBlock>
                    <TextBlock Style="{StaticResource MutedText}" TextAlignment="Center" Margin="0,10,0,24"
                               Text="Conecte sua conta para ver seu perfil. O login acontece no seu navegador, direto no Discord: este aplicativo nunca vê a sua senha." />

                    <Button Content="Conectar com Discord" Style="{StaticResource PrimaryButton}" Padding="16,11"
                            Command="{Binding ConnectCommand}"
                            Visibility="{Binding ShowConnectButton, Converter={StaticResource BoolToVisibility}}" />

                    <StackPanel Visibility="{Binding IsSigningIn, Converter={StaticResource BoolToVisibility}}">
                        <ProgressBar IsIndeterminate="True" Height="4"
                                     Foreground="{StaticResource AccentBrush}" Background="{StaticResource SurfaceRaisedBrush}" BorderThickness="0" />
                        <TextBlock Style="{StaticResource MutedText}" TextAlignment="Center" Margin="0,14"
                                   Text="Aguardando a autorização no navegador…" />
                        <Button Content="Cancelar" Style="{StaticResource SecondaryButton}"
                                Command="{Binding CancelConnectCommand}" />
                    </StackPanel>

                    <Border Background="{StaticResource DangerSurfaceBrush}" CornerRadius="6" Padding="12" Margin="0,18,0,0"
                            Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap" FontSize="13" />
                    </Border>
                </StackPanel>
            </Border>
        </ScrollViewer>

        <!-- Tela principal -->
        <Grid Margin="20" Visibility="{Binding IsConnected, Converter={StaticResource BoolToVisibility}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Cabeçalho: conta conectada -->
            <Border Grid.Row="0" Style="{StaticResource Card}">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Grid Width="64" Height="64" VerticalAlignment="Top">
                            <Ellipse Fill="{StaticResource SurfaceRaisedBrush}" />
                            <TextBlock Text="{Binding Profile.Initial}" FontSize="26" FontWeight="SemiBold"
                                       Foreground="{StaticResource MutedTextBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <Ellipse>
                                <Ellipse.Fill>
                                    <ImageBrush ImageSource="{Binding Profile.AvatarUrl, TargetNullValue={x:Null}}" Stretch="UniformToFill" />
                                </Ellipse.Fill>
                            </Ellipse>
                        </Grid>

                        <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                            <StackPanel Visibility="{Binding HasProfile, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="{Binding Profile.DisplayName}" FontSize="20" FontWeight="Bold" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding Profile.Handle}" Style="{StaticResource MutedText}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                                <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                    <TextBlock Text="ID: " Style="{StaticResource MutedText}" />
                                    <TextBox Text="{Binding Profile.Id, Mode=OneWay}" Style="{StaticResource SelectableText}" />
                                </StackPanel>
                            </StackPanel>
                            <TextBlock Text="Carregando perfil…" Style="{StaticResource MutedText}"
                                       Visibility="{Binding IsLoadingProfile, Converter={StaticResource BoolToVisibility}}" />
                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                <Ellipse Width="8" Height="8" Fill="{StaticResource SuccessBrush}" VerticalAlignment="Center" />
                                <TextBlock Text="Conta conectada" Margin="6,0,0,0" FontSize="13" Foreground="{StaticResource SuccessBrush}" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,14,0,0" Visibility="{Binding HasProfile, Converter={StaticResource BoolToVisibility}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="URL do avatar: " Style="{StaticResource MutedText}" />
                        <TextBox Grid.Column="1" Text="{Binding Profile.AvatarUrl, Mode=OneWay}" Style="{StaticResource SelectableText}" />
                    </Grid>

                    <WrapPanel Margin="0,16,0,0">
                        <Button Content="Atualizar perfil" Style="{StaticResource PrimaryButton}" Margin="0,0,10,0"
                                Command="{Binding RefreshProfileCommand}" />
                        <Button Content="Desconectar" Style="{StaticResource DangerButton}"
                                Command="{Binding DisconnectCommand}" />
                    </WrapPanel>
                </StackPanel>
            </Border>

            <!-- Erro do perfil -->
            <Border Grid.Row="1" Background="{StaticResource DangerSurfaceBrush}" CornerRadius="6" Padding="12" Margin="0,12,0,0"
                    Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap" FontSize="13" />
            </Border>

            <!-- Amigos no sistema ScreenCord (API central) -->
            <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,12,0,0" DataContext="{Binding Friends}">
                <Border.Resources>
                    <Style x:Key="SectionHeader" TargetType="TextBlock">
                        <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
                        <Setter Property="FontSize" Value="12" />
                        <Setter Property="FontWeight" Value="SemiBold" />
                        <Setter Property="Margin" Value="0,10,0,2" />
                    </Style>

                    <!-- Uma pessoa, com as ações possíveis para a relação atual. -->
                    <DataTemplate x:Key="PersonTemplate">
                        <Grid Margin="0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid Width="40" Height="40">
                                <Ellipse Fill="{StaticResource SurfaceRaisedBrush}" />
                                <Ellipse>
                                    <Ellipse.Fill>
                                        <ImageBrush ImageSource="{Binding AvatarUrl, TargetNullValue={x:Null}}" Stretch="UniformToFill" />
                                    </Ellipse.Fill>
                                </Ellipse>
                            </Grid>
                            <StackPanel Grid.Column="1" Margin="12,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" FontSize="14" TextTrimming="CharacterEllipsis" />
                                <TextBlock FontSize="12" Foreground="{StaticResource MutedTextBrush}" TextTrimming="CharacterEllipsis">
                                    <Run Text="{Binding Handle, Mode=OneWay}" /><Run Text=" · ID " /><Run Text="{Binding DiscordId, Mode=OneWay}" />
                                </TextBlock>
                            </StackPanel>
                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Content="Adicionar" Style="{StaticResource PrimaryButton}" Padding="12,5" FontSize="12"
                                        Visibility="{Binding CanAdd, Converter={StaticResource BoolToVisibility}}"
                                        Command="{Binding DataContext.AddCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding}" />
                                <Button Content="Aceitar" Style="{StaticResource PrimaryButton}" Padding="12,5" FontSize="12"
                                        Visibility="{Binding CanAccept, Converter={StaticResource BoolToVisibility}}"
                                        Command="{Binding DataContext.AcceptCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding}" />
                                <Button Content="Recusar" Style="{StaticResource SecondaryButton}" Padding="12,5" FontSize="12" Margin="8,0,0,0"
                                        Visibility="{Binding CanAccept, Converter={StaticResource BoolToVisibility}}"
                                        Command="{Binding DataContext.DeclineCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding}" />
                                <Button Content="Cancelar pedido" Style="{StaticResource SecondaryButton}" Padding="12,5" FontSize="12"
                                        Visibility="{Binding IsPendingOutgoing, Converter={StaticResource BoolToVisibility}}"
                                        Command="{Binding DataContext.DeclineCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding}" />
                                <Button Content="Remover" Style="{StaticResource DangerButton}" Padding="12,5" FontSize="12"
                                        Visibility="{Binding IsFriend, Converter={StaticResource BoolToVisibility}}"
                                        Command="{Binding DataContext.RemoveCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding}" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </Border.Resources>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel>
                        <TextBlock Text="Amigos" FontSize="17" FontWeight="Bold" />
                        <TextBlock Style="{StaticResource MutedText}" FontSize="12" Margin="0,2,0,0"
                                   Text="Amigos no ScreenCord: pessoas que também entraram aqui com o Discord. Não é a sua lista de amigos do Discord." />
                    </StackPanel>

                    <!-- Busca de usuários do sistema -->
                    <Grid Grid.Row="1" Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="SearchBox" Style="{StaticResource SearchBox}"
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 AutomationProperties.Name="Buscar usuários">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Enter" Command="{Binding SearchCommand}" />
                                <KeyBinding Key="Escape" Command="{Binding ClearSearchCommand}" />
                            </TextBox.InputBindings>
                        </TextBox>
                        <TextBlock Text="Buscar usuário para adicionar (ex.: @fulano)" Margin="12,0,0,0" VerticalAlignment="Center"
                                   IsHitTestVisible="False" Foreground="{StaticResource MutedTextBrush}" FontSize="14">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <Button Grid.Column="1" Content="Buscar" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0"
                                Command="{Binding SearchCommand}" />
                        <Button Grid.Column="2" Content="Voltar aos amigos" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0"
                                Command="{Binding ClearSearchCommand}"
                                Visibility="{Binding ShowSearchResults, Converter={StaticResource BoolToVisibility}}" />
                    </Grid>

                    <!-- Erro de carregamento ou de uma ação -->
                    <Border Grid.Row="2" Background="{StaticResource DangerSurfaceBrush}" CornerRadius="6" Padding="12" Margin="0,12,0,0"
                            Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap" FontSize="13" VerticalAlignment="Center" />
                            <Button Grid.Column="1" Content="Tentar novamente" Style="{StaticResource SecondaryButton}" Padding="12,5" FontSize="12" Margin="12,0,0,0"
                                    Command="{Binding ReloadCommand}" />
                        </Grid>
                    </Border>

                    <ScrollViewer Grid.Row="3" Margin="0,8,0,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel>

                            <!-- Resultados da busca -->
                            <StackPanel Visibility="{Binding ShowSearchResults, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="RESULTADOS DA BUSCA" Style="{StaticResource SectionHeader}" />
                                <TextBlock Text="Buscando…" Style="{StaticResource MutedText}" Margin="0,8"
                                           Visibility="{Binding IsSearching, Converter={StaticResource BoolToVisibility}}" />
                                <TextBlock Text="{Binding SearchMessage}" Style="{StaticResource MutedText}" Margin="0,8"
                                           Visibility="{Binding HasSearchMessage, Converter={StaticResource BoolToVisibility}}" />
                                <ItemsControl ItemsSource="{Binding SearchResults}" ItemTemplate="{StaticResource PersonTemplate}" />
                            </StackPanel>

                            <!-- Solicitações e amigos -->
                            <StackPanel Visibility="{Binding ShowFriends, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="Carregando…" Style="{StaticResource MutedText}" Margin="0,8"
                                           Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}" />

                                <StackPanel Visibility="{Binding HasIncomingRequests, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock Text="SOLICITAÇÕES RECEBIDAS" Style="{StaticResource SectionHeader}" />
                                    <ItemsControl ItemsSource="{Binding IncomingRequests}" ItemTemplate="{StaticResource PersonTemplate}" />
                                </StackPanel>

                                <StackPanel Visibility="{Binding HasOutgoingRequests, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock Text="SOLICITAÇÕES ENVIADAS" Style="{StaticResource SectionHeader}" />
                                    <ItemsControl ItemsSource="{Binding OutgoingRequests}" ItemTemplate="{StaticResource PersonTemplate}" />
                                </StackPanel>

                                <StackPanel Visibility="{Binding HasFriends, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock Text="SEUS AMIGOS" Style="{StaticResource SectionHeader}" />
                                    <ItemsControl ItemsSource="{Binding Friends}" ItemTemplate="{StaticResource PersonTemplate}" />
                                </StackPanel>

                                <TextBlock Style="{StaticResource MutedText}" Margin="0,14,0,0"
                                           Text="Você ainda não tem amigos aqui. Busque alguém pelo nome de usuário para enviar uma solicitação."
                                           Visibility="{Binding ShowNoFriends, Converter={StaticResource BoolToVisibility}}" />
                            </StackPanel>

                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
