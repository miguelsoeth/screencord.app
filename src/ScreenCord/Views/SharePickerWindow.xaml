<Window x:Class="ScreenCord.Views.SharePickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:ScreenCord.ViewModels"
        xmlns:views="clr-namespace:ScreenCord.Views"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:SharePickerViewModel}"
        Title="{Binding HeaderText}"
        Icon="/ScreenCord;component/Assets/screencord.ico"
        Width="560" Height="600"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        views:Motion.WindowTransitions="True"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{StaticResource WindowBackgroundBrush}"
        BorderBrush="{StaticResource BorderBrush}"
        BorderThickness="1"
        Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">

    <Window.Resources>
        <!-- Escolha segmentada: uma pílula por opção, a marcada em destaque. -->
        <Style x:Key="SegmentRadio" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
            <Setter Property="Background" Value="{StaticResource SurfaceRaisedBrush}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid x:Name="Root" RenderTransformOrigin="0.5,0.5">
                            <Grid.RenderTransform>
                                <ScaleTransform />
                            </Grid.RenderTransform>
                            <Border Background="{TemplateBinding Background}" CornerRadius="6" />
                            <Border x:Name="Hover" Background="#14FFFFFF" CornerRadius="6" Opacity="0" />
                            <Border x:Name="Checked" Background="{StaticResource AccentBrush}" CornerRadius="6" Opacity="0" />
                            <Border x:Name="FocusRing" BorderBrush="{StaticResource TextBrush}" BorderThickness="1" CornerRadius="6" Opacity="0" />
                            <ContentPresenter Margin="12,7" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                                <Trigger.EnterActions><BeginStoryboard Storyboard="{StaticResource HoverIn}" /></Trigger.EnterActions>
                                <Trigger.ExitActions><BeginStoryboard Storyboard="{StaticResource HoverOut}" /></Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Foreground" Value="White" />
                                <Trigger.EnterActions><BeginStoryboard Storyboard="{StaticResource CheckedIn}" /></Trigger.EnterActions>
                                <Trigger.ExitActions><BeginStoryboard Storyboard="{StaticResource CheckedOut}" /></Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Trigger.EnterActions><BeginStoryboard Storyboard="{StaticResource FocusIn}" /></Trigger.EnterActions>
                                <Trigger.ExitActions><BeginStoryboard Storyboard="{StaticResource FocusOut}" /></Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Trigger.EnterActions><BeginStoryboard Storyboard="{StaticResource PressIn}" /></Trigger.EnterActions>
                                <Trigger.ExitActions><BeginStoryboard Storyboard="{StaticResource PressOut}" /></Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Root" Property="Opacity" Value="0.4" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,14,0,6" />
        </Style>

        <Style x:Key="SourceItem" TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Grid Background="Transparent" Margin="0,1" views:Motion.AppearOnLoad="True">
                            <Border x:Name="Hover" Background="{StaticResource SurfaceRaisedBrush}" CornerRadius="6" Opacity="0" />
                            <Border x:Name="Checked" Background="{StaticResource InfoSurfaceBrush}" BorderBrush="{StaticResource AccentBrush}"
                                    BorderThickness="1" CornerRadius="6" Opacity="0" />
                            <ContentPresenter Margin="11,9" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions><BeginStoryboard Storyboard="{StaticResource HoverIn}" /></Trigger.EnterActions>
                                <Trigger.ExitActions><BeginStoryboard Storyboard="{StaticResource HoverOut}" /></Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Trigger.EnterActions><BeginStoryboard Storyboard="{StaticResource CheckedIn}" /></Trigger.EnterActions>
                                <Trigger.ExitActions><BeginStoryboard Storyboard="{StaticResource CheckedOut}" /></Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="{Binding HeaderText}" FontSize="18" FontWeight="Bold" />
                <TextBlock Style="{StaticResource MutedText}" Margin="0,2,0,0"
                           Text="{Binding HintText}"
                           Visibility="{Binding IsChange, Converter={StaticResource BoolToVisibility}}" />
            </StackPanel>
            <Button Grid.Column="1" Style="{StaticResource GhostIconButton}" Width="32" Height="32" Margin="0,-6,-8,0"
                    VerticalAlignment="Top" Click="OnCloseClick" ToolTip="Fechar" AutomationProperties.Name="Fechar">
                <Path Data="{StaticResource CloseIcon}" Style="{StaticResource IconPath}" Width="16" Height="16" />
            </Button>
        </Grid>

        <!-- Tela inteira ou uma janela -->
        <Grid Grid.Row="1" Margin="0,16,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal">
                <RadioButton Content="Tela" Style="{StaticResource SegmentRadio}" GroupName="Kind"
                             IsChecked="{Binding IsScreenKind}" AutomationProperties.Name="Compartilhar uma tela" />
                <RadioButton Content="Janela" Style="{StaticResource SegmentRadio}" GroupName="Kind"
                             IsChecked="{Binding IsWindowKind}" AutomationProperties.Name="Compartilhar uma janela" />
            </StackPanel>
            <Button Grid.Column="1" Style="{StaticResource GhostIconButton}" Width="32" Height="32"
                    Command="{Binding RefreshCommand}" ToolTip="Atualizar lista" AutomationProperties.Name="Atualizar lista">
                <Path Data="{StaticResource RefreshIcon}" Style="{StaticResource IconPath}" Width="16" Height="16" />
            </Button>
        </Grid>

        <Border Grid.Row="2" Background="{StaticResource SurfaceBrush}" CornerRadius="8" Padding="6">
            <Grid>
                <ListBox x:Name="SourceList" ItemsSource="{Binding Sources}" SelectedItem="{Binding SelectedSource}"
                         Background="Transparent" BorderThickness="0"
                         ItemContainerStyle="{StaticResource SourceItem}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         AutomationProperties.Name="O que compartilhar"
                         MouseDoubleClick="OnSourceDoubleClick">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Width="34" Height="34" CornerRadius="6" Background="{StaticResource SurfaceRaisedBrush}">
                                    <Path Data="{StaticResource MonitorIcon}" Width="18" Height="18" Stretch="Uniform"
                                          Fill="{StaticResource MutedTextBrush}" x:Name="KindIcon" />
                                </Border>
                                <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Subtitle}" FontSize="11" Foreground="{StaticResource MutedTextBrush}" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Grid>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsScreen}" Value="False">
                                    <Setter TargetName="KindIcon" Property="Data" Value="{StaticResource WindowIcon}" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <TextBlock Text="{Binding EmptyText}" Style="{StaticResource MutedText}" HorizontalAlignment="Center" VerticalAlignment="Center"
                           Visibility="{Binding HasNoSources, Converter={StaticResource BoolToVisibility}}" />
            </Grid>
        </Border>

        <!-- Qualidade da transmissão -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 540p a 30 ou 60 fps, 720p só a 30 fps; 1080p aparece desligado (plano pago). A taxa de bits é automática. -->
            <StackPanel Margin="0,0,24,0">
                <TextBlock Text="RESOLUÇÃO" Style="{StaticResource FieldLabel}" />
                <ItemsControl ItemsSource="{Binding Resolutions.Options}" Focusable="False">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <RadioButton Style="{StaticResource SegmentRadio}" GroupName="Resolution" Content="{Binding Label}"
                                         IsChecked="{Binding IsSelected}" IsEnabled="{Binding IsAvailable}"
                                         ToolTip="{Binding Detail}" ToolTipService.ShowOnDisabled="True" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <StackPanel Grid.Column="1">
                <TextBlock Text="TAXA DE QUADROS" Style="{StaticResource FieldLabel}" />
                <ItemsControl ItemsSource="{Binding FrameRates.Options}" Focusable="False">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <RadioButton Style="{StaticResource SegmentRadio}" GroupName="FrameRate" Content="{Binding Label}"
                                         IsChecked="{Binding IsSelected}" IsEnabled="{Binding IsAvailable}"
                                         ToolTip="{Binding Detail}" ToolTipService.ShowOnDisabled="True" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <CheckBox Grid.Row="2" Grid.ColumnSpan="2" Margin="0,16,0,0" IsChecked="{Binding ShareAudio}"
                      Foreground="{StaticResource TextBrush}" VerticalContentAlignment="Center" Cursor="Hand">
                <StackPanel Margin="4,0,0,0">
                    <TextBlock Text="Compartilhar áudio" FontSize="13" FontWeight="SemiBold" />
                    <TextBlock Text="Só o áudio do programa da janela." FontSize="11" Foreground="{StaticResource MutedTextBrush}"
                               Visibility="{Binding IsWindowKind, Converter={StaticResource BoolToVisibility}}" />
                    <TextBlock FontSize="11" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap"
                               Text="Todo o áudio do computador, inclusive chamadas."
                               Visibility="{Binding IsScreenKind, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>
            </CheckBox>
        </Grid>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="Cancelar" Style="{StaticResource SecondaryButton}" IsCancel="True" />
            <Button Content="{Binding ConfirmText}" Style="{StaticResource PrimaryButton}" Margin="10,0,0,0" IsDefault="True"
                    IsEnabled="{Binding CanShare}" Click="OnShareClick" />
        </StackPanel>
    </Grid>
</Window>
