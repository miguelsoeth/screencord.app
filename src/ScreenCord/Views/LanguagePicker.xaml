<UserControl x:Class="ScreenCord.Views.LanguagePicker"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:ScreenCord.Localization"
             xmlns:views="clr-namespace:ScreenCord.Views">
    <!-- Botão de idioma no estilo das ações do cabeçalho; o menu abre embaixo, alinhado à direita do botão. -->
    <UserControl.Resources>
        <views:InverseBooleanConverter x:Key="InverseBool" />
    </UserControl.Resources>

    <Grid>
        <!-- Com o menu aberto, o clique no botão só fecha o menu (sem reabrir em seguida). -->
        <ToggleButton x:Name="Toggle" Style="{StaticResource HeaderIconToggleButton}"
                      IsHitTestVisible="{Binding IsOpen, ElementName=Menu, Converter={StaticResource InverseBool}}"
                      ToolTip="{l:Tr Language}" AutomationProperties.Name="{l:Tr Language}">
            <Path Data="{StaticResource TranslateIcon}" Style="{StaticResource IconPath}" />
        </ToggleButton>

        <Popup x:Name="Menu" IsOpen="{Binding IsChecked, ElementName=Toggle, Mode=TwoWay}" StaysOpen="False"
               PlacementTarget="{Binding ElementName=Toggle}" Placement="Custom"
               AllowsTransparency="True" PopupAnimation="Fade" Opened="OnMenuOpened">
            <Border Style="{StaticResource Card}" Padding="6" Margin="14" MinWidth="176"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                    TextElement.Foreground="{StaticResource TextBrush}">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="22" ShadowDepth="0" Opacity="0.55" Color="Black" />
                </Border.Effect>
                <StackPanel KeyboardNavigation.DirectionalNavigation="Cycle">
                    <TextBlock Text="{l:Tr Language}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource MutedTextBrush}" Margin="10,4,10,4" />
                    <Button x:Name="PortugueseOption" Style="{StaticResource MenuOption}" Tag="pt" Click="OnOptionClick">
                        <DockPanel>
                            <Path x:Name="PortugueseCheck" DockPanel.Dock="Right" Data="{StaticResource CheckIcon}" Style="{StaticResource IconPath}"
                                  Fill="{StaticResource AccentBrush}" Width="14" Height="14" Margin="12,0,0,0" />
                            <TextBlock Text="{l:Tr LanguagePortuguese}" />
                        </DockPanel>
                    </Button>
                    <Button x:Name="EnglishOption" Style="{StaticResource MenuOption}" Tag="en" Click="OnOptionClick">
                        <DockPanel>
                            <Path x:Name="EnglishCheck" DockPanel.Dock="Right" Data="{StaticResource CheckIcon}" Style="{StaticResource IconPath}"
                                  Fill="{StaticResource AccentBrush}" Width="14" Height="14" Margin="12,0,0,0" />
                            <TextBlock Text="{l:Tr LanguageEnglish}" />
                        </DockPanel>
                    </Button>
                    <Button x:Name="SpanishOption" Style="{StaticResource MenuOption}" Tag="es" Click="OnOptionClick">
                        <DockPanel>
                            <Path x:Name="SpanishCheck" DockPanel.Dock="Right" Data="{StaticResource CheckIcon}" Style="{StaticResource IconPath}"
                                  Fill="{StaticResource AccentBrush}" Width="14" Height="14" Margin="12,0,0,0" />
                            <TextBlock Text="{l:Tr LanguageSpanish}" />
                        </DockPanel>
                    </Button>
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</UserControl>
