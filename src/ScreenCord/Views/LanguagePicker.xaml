<UserControl x:Class="ScreenCord.Views.LanguagePicker"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:ScreenCord.Localization"
             xmlns:views="clr-namespace:ScreenCord.Views">
    <!-- Botão de idioma no estilo das ações do cabeçalho; o menu abre embaixo, alinhado à direita do botão. -->
    <UserControl.Resources>
        <views:InverseBooleanConverter x:Key="InverseBool" />
        <Style x:Key="LanguageOption" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid Background="Transparent">
                            <Border x:Name="Hover" Background="{StaticResource SurfaceRaisedBrush}" CornerRadius="6" Opacity="0" />
                            <Border x:Name="FocusRing" BorderBrush="{StaticResource TextBrush}" BorderThickness="1" CornerRadius="6" Opacity="0" />
                            <ContentPresenter Margin="10,7" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions><BeginStoryboard Storyboard="{StaticResource HoverIn}" /></Trigger.EnterActions>
                                <Trigger.ExitActions><BeginStoryboard Storyboard="{StaticResource HoverOut}" /></Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Trigger.EnterActions><BeginStoryboard Storyboard="{StaticResource FocusIn}" /></Trigger.EnterActions>
                                <Trigger.ExitActions><BeginStoryboard Storyboard="{StaticResource FocusOut}" /></Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <!-- Com o menu aberto, o clique no botão só fecha o menu (sem reabrir em seguida). -->
        <ToggleButton x:Name="Toggle" Style="{StaticResource HeaderIconToggleButton}"
                      IsHitTestVisible="{Binding IsOpen, ElementName=Menu, Converter={StaticResource InverseBool}}"
                      ToolTip="{l:Tr Language}" AutomationProperties.Name="{l:Tr Language}">
            <Path Data="{StaticResource TranslateIcon}" Style="{StaticResource IconPath}" />
        </ToggleButton>

        <Popup x:Name="Menu" IsOpen="{Binding IsChecked, ElementName=Toggle, Mode=TwoWay}" StaysOpen="False"
               PlacementTarget="{Binding ElementName=Toggle}" Placement="Custom"
               AllowsTransparency="True" PopupAnimation="Fade" Opened="OnMenuOpened">
            <Border Style="{StaticResource Card}" Padding="6" Margin="14" MinWidth="176"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                    TextElement.Foreground="{StaticResource TextBrush}">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="22" ShadowDepth="0" Opacity="0.55" Color="Black" />
                </Border.Effect>
                <StackPanel KeyboardNavigation.DirectionalNavigation="Cycle">
                    <TextBlock Text="{l:Tr Language}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource MutedTextBrush}" Margin="10,4,10,4" />
                    <Button x:Name="PortugueseOption" Style="{StaticResource LanguageOption}" Tag="pt" Click="OnOptionClick">
                        <DockPanel>
                            <Path x:Name="PortugueseCheck" DockPanel.Dock="Right" Data="{StaticResource CheckIcon}" Style="{StaticResource IconPath}"
                                  Fill="{StaticResource AccentBrush}" Width="14" Height="14" Margin="12,0,0,0" />
                            <TextBlock Text="{l:Tr LanguagePortuguese}" />
                        </DockPanel>
                    </Button>
                    <Button x:Name="EnglishOption" Style="{StaticResource LanguageOption}" Tag="en" Click="OnOptionClick">
                        <DockPanel>
                            <Path x:Name="EnglishCheck" DockPanel.Dock="Right" Data="{StaticResource CheckIcon}" Style="{StaticResource IconPath}"
                                  Fill="{StaticResource AccentBrush}" Width="14" Height="14" Margin="12,0,0,0" />
                            <TextBlock Text="{l:Tr LanguageEnglish}" />
                        </DockPanel>
                    </Button>
                    <Button x:Name="SpanishOption" Style="{StaticResource LanguageOption}" Tag="es" Click="OnOptionClick">
                        <DockPanel>
                            <Path x:Name="SpanishCheck" DockPanel.Dock="Right" Data="{StaticResource CheckIcon}" Style="{StaticResource IconPath}"
                                  Fill="{StaticResource AccentBrush}" Width="14" Height="14" Margin="12,0,0,0" />
                            <TextBlock Text="{l:Tr LanguageSpanish}" />
                        </DockPanel>
                    </Button>
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</UserControl>
