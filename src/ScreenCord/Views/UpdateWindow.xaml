<Window x:Class="ScreenCord.Views.UpdateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:ScreenCord.Localization"
        Title="{l:Tr UpdatingTitle}"
        Icon="/ScreenCord;component/Assets/screencord.ico"
        Width="400" SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="NoResize"
        Topmost="True"
        Background="{StaticResource WindowBackgroundBrush}"
        BorderBrush="{StaticResource BorderBrush}"
        BorderThickness="1"
        Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">

    <!-- Atualização automática: aparece só quando há versão nova; some quando o instalador assume. -->
    <StackPanel Margin="24,20,24,24">
        <TextBlock Style="{StaticResource Wordmark}" FontSize="18">
            <Run Text="Screen" /><Run Text="Cord" Foreground="{StaticResource WordmarkAccentBrush}" />
        </TextBlock>
        <TextBlock x:Name="StatusText" Margin="0,14,0,10" FontSize="13" TextWrapping="Wrap"
                   Text="{l:Tr CheckingForUpdates}" />
        <ProgressBar x:Name="Progress" Height="6" Minimum="0" Maximum="1" IsIndeterminate="True"
                     Background="{StaticResource SurfaceRaisedBrush}" Foreground="{StaticResource AccentBrush}" BorderThickness="0" />
    </StackPanel>
</Window>
