<Window x:Class="ScreenCord.Views.UpdateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:ScreenCord.Localization"
        Title="{l:Tr UpdatingTitle}"
        Icon="/ScreenCord;component/Assets/screencord.ico"
        Width="460" SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="NoResize"
        Topmost="True"
        Background="{StaticResource WindowBackgroundBrush}"
        BorderBrush="{StaticResource BorderBrush}"
        BorderThickness="1"
        Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">

    <!-- Atualização: a pergunta (versão nova ou obrigatória) e depois o progresso do download; some quando o
         instalador assume. -->
    <StackPanel Margin="24,20,24,24">
        <TextBlock Style="{StaticResource Wordmark}" FontSize="18">
            <Run Text="Screen" /><Run Text="Cord" Foreground="{StaticResource WordmarkAccentBrush}" />
        </TextBlock>
        <TextBlock x:Name="StatusText" Margin="0,14,0,10" FontSize="13" TextWrapping="Wrap"
                   Text="{l:Tr CheckingForUpdates}" />
        <ProgressBar x:Name="Progress" Height="6" Minimum="0" Maximum="1" IsIndeterminate="True"
                     Background="{StaticResource SurfaceRaisedBrush}" Foreground="{StaticResource AccentBrush}" BorderThickness="0" />

        <!-- Só na pergunta. Esc vale "Agora não" (ou "Sair", quando a atualização é obrigatória). -->
        <DockPanel x:Name="Buttons" Margin="0,8,0,0" Visibility="Collapsed">
            <Button x:Name="SkipButton" DockPanel.Dock="Left" Style="{StaticResource SecondaryButton}" FontSize="13"
                    Content="{l:Tr SkipThisVersion}" Click="OnSkipClick" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="LaterButton" Style="{StaticResource SecondaryButton}" FontSize="13"
                        Content="{l:Tr NotNow}" IsCancel="True" Click="OnLaterClick" />
                <Button x:Name="ExitButton" Style="{StaticResource SecondaryButton}" FontSize="13"
                        Content="{l:Tr Exit}" Click="OnExitClick" Visibility="Collapsed" />
                <Button x:Name="InstallButton" Style="{StaticResource PrimaryButton}" FontSize="13" Margin="10,0,0,0"
                        Content="{l:Tr UpdateNow}" IsDefault="True" Click="OnInstallClick" />
            </StackPanel>
        </DockPanel>
    </StackPanel>
</Window>
