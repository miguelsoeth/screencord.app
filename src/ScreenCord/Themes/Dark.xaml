<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Paleta escura "gamer" no estilo do Discord: quase preto, levemente azulado; o neon fica só nos destaques. -->
    <SolidColorBrush x:Key="WindowBrush" Color="#0A0B10" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="#121319" />
    <SolidColorBrush x:Key="SurfaceRaisedBrush" Color="#1E2029" />
    <SolidColorBrush x:Key="BorderBrush" Color="#2B2E3C" />
    <SolidColorBrush x:Key="TextBrush" Color="#EDEEF5" />
    <SolidColorBrush x:Key="MutedTextBrush" Color="#9A9DB0" />
    <SolidColorBrush x:Key="SuccessBrush" Color="#2FD27A" />
    <SolidColorBrush x:Key="DangerBrush" Color="#F2475E" />
    <SolidColorBrush x:Key="DangerSurfaceBrush" Color="#2E161D" />
    <SolidColorBrush x:Key="InfoSurfaceBrush" Color="#181B30" />
    <SolidColorBrush x:Key="CrownBrush" Color="#F0B232" />

    <!-- Destaque: o degradê neon azul → violeta do ícone (botões principais, seleção, progresso, foco). -->
    <LinearGradientBrush x:Key="AccentBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#2E9BFF" Offset="0" />
        <GradientStop Color="#4C5BFF" Offset="0.5" />
        <GradientStop Color="#9B4DFF" Offset="1" />
    </LinearGradientBrush>
    <Color x:Key="GlowColor">#5B4DFF</Color>

    <!-- Movimento: transições curtas (~100–200 ms) que desaceleram no fim, para a interface responder na hora e sem
         saltos. Hover, foco e seleção acendem uma camada por cima (opacidade animada) em vez de trocar a cor de uma vez;
         pressionar encolhe o controle de leve. Mostrar/esconder painéis, diálogos e popups fica em Views/Motion.cs. -->
    <CubicEase x:Key="EaseOut" EasingMode="EaseOut" />
    <!-- Fundo do hover dos botões só com ícone; a ação destrutiva troca por vermelho no Style.Resources. -->
    <SolidColorBrush x:Key="IconHoverBrush" Color="#1E2029" />

    <!-- Fundo das janelas: quase preto, com um brilho azul fraco no alto à esquerda e violeta embaixo à direita. -->
    <DrawingBrush x:Key="WindowBackgroundBrush" Stretch="Fill" ViewboxUnits="Absolute" Viewbox="0,0,1,1">
        <DrawingBrush.Drawing>
            <DrawingGroup>
                <GeometryDrawing Geometry="M0,0 H1 V1 H0 Z">
                    <GeometryDrawing.Brush>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#0A0B12" Offset="0" />
                            <GradientStop Color="#09090E" Offset="0.5" />
                            <GradientStop Color="#0C0A13" Offset="1" />
                        </LinearGradientBrush>
                    </GeometryDrawing.Brush>
                </GeometryDrawing>
                <GeometryDrawing Geometry="M0,0 H1 V1 H0 Z">
                    <GeometryDrawing.Brush>
                        <RadialGradientBrush Center="0.05,0" GradientOrigin="0.05,0" RadiusX="0.6" RadiusY="0.75">
                            <GradientStop Color="#162E7BFF" Offset="0" />
                            <GradientStop Color="#002E7BFF" Offset="1" />
                        </RadialGradientBrush>
                    </GeometryDrawing.Brush>
                </GeometryDrawing>
                <GeometryDrawing Geometry="M0,0 H1 V1 H0 Z">
                    <GeometryDrawing.Brush>
                        <RadialGradientBrush Center="1,1" GradientOrigin="1,1" RadiusX="0.65" RadiusY="0.8">
                            <GradientStop Color="#148B4DFF" Offset="0" />
                            <GradientStop Color="#008B4DFF" Offset="1" />
                        </RadialGradientBrush>
                    </GeometryDrawing.Brush>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingBrush.Drawing>
    </DrawingBrush>

    <!-- Cartões em relevo: fundo um pouco mais claro no alto e borda com luz em cima e reflexo violeta embaixo. -->
    <LinearGradientBrush x:Key="CardBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#15161D" Offset="0" />
        <GradientStop Color="#101117" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="CardBorderBrush" StartPoint="0,0" EndPoint="0.3,1">
        <GradientStop Color="#665C78FF" Offset="0" />
        <GradientStop Color="#24FFFFFF" Offset="0.45" />
        <GradientStop Color="#448B4DFF" Offset="1" />
    </LinearGradientBrush>

    <!-- Botões em relevo: superfície elevada com borda clara em cima. -->
    <LinearGradientBrush x:Key="RaisedButtonBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#24262F" Offset="0" />
        <GradientStop Color="#1A1B22" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="RaisedButtonBorderBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#454959" Offset="0" />
        <GradientStop Color="#24262F" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="DangerFilledBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FF5F7A" Offset="0" />
        <GradientStop Color="#D9304F" Offset="1" />
    </LinearGradientBrush>
    <!-- Reflexo na metade de cima dos botões, para o acabamento 3D. -->
    <LinearGradientBrush x:Key="ButtonGlossBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#2EFFFFFF" Offset="0" />
        <GradientStop Color="#10FFFFFF" Offset="0.48" />
        <GradientStop Color="#00FFFFFF" Offset="0.52" />
        <GradientStop Color="#00FFFFFF" Offset="1" />
    </LinearGradientBrush>

    <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

    <!-- Marca ScreenCord: "Screen" na cor do texto e "Cord" no gradiente azul/violeta do ícone. -->
    <LinearGradientBrush x:Key="WordmarkAccentBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#3FA2FF" Offset="0" />
        <GradientStop Color="#4C5BFF" Offset="0.55" />
        <GradientStop Color="#8B4DFF" Offset="1" />
    </LinearGradientBrush>

    <Style x:Key="Wordmark" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe UI Variable Display, Segoe UI" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
    </Style>

    <!-- Transições compartilhadas pelos templates. Cada template nomeia as partes que elas animam: "Hover" (camada do
         hover), "Checked" (camada de marcado/selecionado), "FocusRing" (contorno do foco pelo teclado) e "Root" (o que
         encolhe ao pressionar, com um ScaleTransform no RenderTransform). -->
    <Storyboard x:Key="HoverIn">
        <DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.12" EasingFunction="{StaticResource EaseOut}" />
    </Storyboard>
    <Storyboard x:Key="HoverOut">
        <DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2" EasingFunction="{StaticResource EaseOut}" />
    </Storyboard>
    <Storyboard x:Key="CheckedIn">
        <DoubleAnimation Storyboard.TargetName="Checked" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.16" EasingFunction="{StaticResource EaseOut}" />
    </Storyboard>
    <Storyboard x:Key="CheckedOut">
        <DoubleAnimation Storyboard.TargetName="Checked" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.18" EasingFunction="{StaticResource EaseOut}" />
    </Storyboard>
    <Storyboard x:Key="FocusIn">
        <DoubleAnimation Storyboard.TargetName="FocusRing" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.12" EasingFunction="{StaticResource EaseOut}" />
    </Storyboard>
    <Storyboard x:Key="FocusOut">
        <DoubleAnimation Storyboard.TargetName="FocusRing" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.15" EasingFunction="{StaticResource EaseOut}" />
    </Storyboard>
    <Storyboard x:Key="PressIn">
        <DoubleAnimation Storyboard.TargetName="Root" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="0.95" Duration="0:0:0.08" EasingFunction="{StaticResource EaseOut}" />
        <DoubleAnimation Storyboard.TargetName="Root" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="0.95" Duration="0:0:0.08" EasingFunction="{StaticResource EaseOut}" />
    </Storyboard>
    <Storyboard x:Key="PressOut">
        <DoubleAnimation Storyboard.TargetName="Root" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1" Duration="0:0:0.2" EasingFunction="{StaticResource EaseOut}" />
        <DoubleAnimation Storyboard.TargetName="Root" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1" Duration="0:0:0.2" EasingFunction="{StaticResource EaseOut}" />
    </Storyboard>

    <Style x:Key="BaseButton" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="Background" Value="{StaticResource RaisedButtonBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource RaisedButtonBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="16,8" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid x:Name="Root" RenderTransformOrigin="0.5,0.5">
                        <Grid.RenderTransform>
                            <ScaleTransform />
                        </Grid.RenderTransform>
                        <!-- Brilho extra do hover (só nos botões que definem ButtonHoverGlow), aceso junto com o clarão. -->
                        <Border Background="{TemplateBinding Background}" CornerRadius="8" IsHitTestVisible="False"
                                Opacity="{Binding Opacity, ElementName=Hover}" Effect="{DynamicResource ButtonHoverGlow}" />
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8" />
                        <!-- Reflexo (some nos botões vazados, que trocam o recurso por transparente) e clarão do hover. -->
                        <Border Background="{DynamicResource ButtonGlossBrush}" CornerRadius="8" Margin="1" IsHitTestVisible="False" />
                        <Border x:Name="Hover" Background="#1AFFFFFF" CornerRadius="8" Opacity="0" IsHitTestVisible="False" />
                        <Border x:Name="FocusRing" BorderBrush="{StaticResource TextBrush}" BorderThickness="1" CornerRadius="8"
                                Opacity="0" IsHitTestVisible="False" />
                        <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions><BeginStoryboard Storyboard="{StaticResource HoverIn}" /></Trigger.EnterActions>
                            <Trigger.ExitActions><BeginStoryboard Storyboard="{StaticResource HoverOut}" /></Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Trigger.EnterActions><BeginStoryboard Storyboard="{StaticResource FocusIn}" /></Trigger.EnterActions>
                            <Trigger.ExitActions><BeginStoryboard Storyboard="{StaticResource FocusOut}" /></Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Trigger.EnterActions><BeginStoryboard Storyboard="{StaticResource PressIn}" /></Trigger.EnterActions>
                            <Trigger.ExitActions><BeginStoryboard Storyboard="{StaticResource PressOut}" /></Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Root" Property="Opacity" Value="0.45" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Botão principal: o degradê neon com um brilho em volta, que aumenta ao passar o mouse. -->
    <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
        <Style.Resources>
            <DropShadowEffect x:Key="ButtonHoverGlow" Color="{StaticResource GlowColor}" BlurRadius="26" ShadowDepth="0" Opacity="0.9" />
        </Style.Resources>
        <Setter Property="Background" Value="{StaticResource AccentBrush}" />
        <Setter Property="BorderBrush" Value="#55FFFFFF" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect Color="{StaticResource GlowColor}" BlurRadius="16" ShadowDepth="0" Opacity="0.6" />
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Effect" Value="{x:Null}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource BaseButton}" />

    <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
        <Style.Resources>
            <SolidColorBrush x:Key="ButtonGlossBrush" Color="Transparent" />
        </Style.Resources>
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{StaticResource DangerBrush}" />
        <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
    </Style>

    <Style x:Key="DangerFilledButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
        <Style.Resources>
            <DropShadowEffect x:Key="ButtonHoverGlow" Color="#F2475E" BlurRadius="24" ShadowDepth="0" Opacity="0.8" />
        </Style.Resources>
        <Setter Property="Background" Value="{StaticResource DangerFilledBrush}" />
        <Setter Property="BorderBrush" Value="#55FFFFFF" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect Color="#F2475E" BlurRadius="16" ShadowDepth="0" Opacity="0.5" />
            </Setter.Value>
        </Setter>
    </Style>

