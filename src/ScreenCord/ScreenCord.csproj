<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
    <!-- APIs do Windows 11 (ex.: captura sem a borda amarela) são usadas só quando presentes. -->
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <RootNamespace>ScreenCord</RootNamespace>
    <AssemblyName>ScreenCord</AssemblyName>
    <Version>1.0.0</Version>
    <Product>ScreenCord</Product>
    <ApplicationIcon>Assets\screencord.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Concentus" Version="2.2.2" />
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" Version="10.0.13" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.13" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.13" />
    <PackageReference Include="NAudio.Wasapi" Version="3.1.0" />
    <PackageReference Include="Vortice.Direct3D11" Version="3.8.3" />
    <PackageReference Include="Vortice.MediaFoundation" Version="3.8.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ScreenCord.Contracts\ScreenCord.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\screencord.ico" />
    <Resource Include="Assets\screencord.png" />
    <Content Include="appsettings.json" CopyToOutputDirectory="PreserveNewest" />
    <!-- Configuração local opcional (não versionada), ex.: o Client ID de desenvolvimento. -->
    <Content Include="appsettings.Local.json" Condition="Exists('appsettings.Local.json')" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
